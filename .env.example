# API Configuration
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_URL=http://localhost:3000

# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Razorpay Configuration (REQUIRED - Public Key only)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# Cloudflare Turnstile CAPTCHA (REQUIRED)
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=your_turnstile_site_key

# Feature Flags
VITE_ENABLE_DARK_MODE=true
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_2FA=true
VITE_ENABLE_KYC_VERIFICATION=true
VITE_ENABLE_AI_FEATURES=true

# Multi-Language Support
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,hi,es,fr

# PWA Configuration
VITE_PWA_ENABLED=true

# AI Features (NVIDIA NIM)
VITE_AI_CHATBOT_ENABLED=true

# Performance
VITE_ENABLE_SKELETON_LOADING=true
VITE_ENABLE_LAZY_LOADING=true

# CDN Configuration
VITE_CDN_BASE_URL=https://cdn.yourdomain.com

# Environment
VITE_ENVIRONMENT=development
